{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(composer test:*)",
            "Bash(composer test-coverage:*)",
            "Bash(composer analyse:*)",
            "Bash(composer format:*)",
            "Bash(vendor/bin/pest:*)",
            "Bash(vendor/bin/phpstan analyse:*)",
            "Bash(vendor/bin/pint:*)",
            "Bash(php scripts/domains.php:*)",
            "Bash(git status:*)",
            "Bash(git diff:*)",
            "Bash(git log:*)",
            "Bash(git show:*)",
            "Bash(git branch:*)"
        ]
    }
}
